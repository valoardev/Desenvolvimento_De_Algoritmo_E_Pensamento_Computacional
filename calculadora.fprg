<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Calculadora Universal"/>
        <attribute name="authors" value="lalab"/>
        <attribute name="about" value="Calculadora com 20 funcoes: IMC, area, perimetro, volume, conversoes, financeiro, trigonometria e mais."/>
        <attribute name="saved" value="2026-08-30 08:12:30 "/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
<declare name="opcaoCalculadora" type="Integer" array="False" size=""/>
<comment text="Exibe o menu principal com as 20 funcoes disponiveis"/>
<output expression="&quot;===== CALCULADORA UNIVERSAL =====  |  [1] IMC  |  [2] Area de Figuras  |  [3] Operacoes Aritmeticas  |  [4] Par ou Impar  |  [5] Comparacao de Valores  |  [6] Media Aritmetica  |  [7] Porcentagem  |  [8] Regra de Tres Simples  |  [9] Juros Simples  |  [10] Desconto  |  [11] Conversao de Temperatura  |  [12] Conversor de Unidades  |  [13] Trigonometria  |  [14] Perimetro de Figuras  |  [15] Volume de Solidos  |  [16] Velocidade Media  |  [17] Consumo de Combustivel  |  [18] Calculo de Idade  |  [19] Fatorial de um Numero  |  [20] Numero Primo  |  [0] Sair&quot;" newline="True"/>
<input variable="opcaoCalculadora"/>
<while expression="opcaoCalculadora &lt; 0 or opcaoCalculadora &gt; 20">
<output expression="&quot;Escolha inexistente! Tente novamente..&quot;" newline="True"/>
<output expression="&quot;===== CALCULADORA UNIVERSAL =====  |  [1] IMC  |  [2] Area de Figuras  |  [3] Operacoes Aritmeticas  |  [4] Par ou Impar  |  [5] Comparacao de Valores  |  [6] Media Aritmetica  |  [7] Porcentagem  |  [8] Regra de Tres Simples  |  [9] Juros Simples  |  [10] Desconto  |  [11] Conversao de Temperatura  |  [12] Conversor de Unidades  |  [13] Trigonometria  |  [14] Perimetro de Figuras  |  [15] Volume de Solidos  |  [16] Velocidade Media  |  [17] Consumo de Combustivel  |  [18] Calculo de Idade  |  [19] Fatorial de um Numero  |  [20] Numero Primo  |  [0] Sair&quot;" newline="True"/>
<input variable="opcaoCalculadora"/>
</while>
<if expression="opcaoCalculadora = 0">
<then>
<output expression="&quot;Encerrando o programa!&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 1">
<then>
<comment text="FUNCAO 1 (OBRIGATORIA): Calculo do IMC - Indice de Massa Corporal"/>
<declare name="imc, peso, altura" type="Real" array="False" size=""/>
<comment text="Entrada de dados do usuario"/>
<output expression="&quot;Digite o seu peso (Kg): &quot;" newline="True"/>
<input variable="peso"/>
<output expression="&quot;Digite a sua altura (m): &quot;" newline="True"/>
<input variable="altura"/>
<comment text="Processamento: IMC = peso / altura ao quadrado"/>
<assign variable="imc" expression="peso / (altura ^ 2)"/>
<output expression="&quot;O IMC para peso &quot; &amp; peso &amp; &quot; Kg e altura &quot; &amp; altura &amp; &quot; m e: &quot; &amp; ToFixed(imc, 2)" newline="True"/>
<comment text="Estrutura de decisao para classificar o resultado (tabela da OMS)"/>
<if expression="imc &lt; 18.5">
<then>
<output expression="&quot;Classificacao: Abaixo do Peso&quot;" newline="True"/>
</then>
<else>
<if expression="imc &lt;= 24.9">
<then>
<output expression="&quot;Classificacao: Peso Normal&quot;" newline="True"/>
</then>
<else>
<if expression="imc &lt;= 29.9">
<then>
<output expression="&quot;Classificacao: Excesso de Peso&quot;" newline="True"/>
</then>
<else>
<if expression="imc &lt;= 34.9">
<then>
<output expression="&quot;Classificacao: Obesidade Grau I&quot;" newline="True"/>
</then>
<else>
<if expression="imc &lt;= 39.9">
<then>
<output expression="&quot;Classificacao: Obesidade Grau II&quot;" newline="True"/>
</then>
<else>
<output expression="&quot;Classificacao: Obesidade Morbida (Grau III)&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 2">
<then>
<comment text="FUNCAO 2 (OBRIGATORIA): Calculo de area de figuras geometricas"/>
<declare name="opcaoArea" type="Integer" array="False" size=""/>
<declare name="area, base, altura, raio, diagonalMaior, diagonalMenor, lado, compRet, largRet" type="Real" array="False" size=""/>
<output expression="&quot;Escolha a figura: [1] Quadrado | [2] Triangulo | [3] Circulo | [4] Losango | [5] Retangulo&quot;" newline="True"/>
<input variable="opcaoArea"/>
<if expression="opcaoArea = 1">
<then>
<output expression="&quot;Digite o valor do lado do quadrado (em u.m): &quot;" newline="True"/>
<input variable="lado"/>
<assign variable="area" expression="lado * lado"/>
<output expression="&quot;A area do quadrado e: &quot; &amp; ToFixed(area, 2) &amp; &quot; u.m2&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoArea = 2">
<then>
<output expression="&quot;Digite a base do triangulo (em u.m): &quot;" newline="True"/>
<input variable="base"/>
<output expression="&quot;Digite a altura do triangulo (em u.m): &quot;" newline="True"/>
<input variable="altura"/>
<assign variable="area" expression="(base * altura) / 2"/>
<output expression="&quot;A area do triangulo e: &quot; &amp; ToFixed(area, 2) &amp; &quot; u.m2&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoArea = 3">
<then>
<output expression="&quot;Digite o raio do circulo (em u.m): &quot;" newline="True"/>
<input variable="raio"/>
<assign variable="area" expression="3.14 * (raio ^ 2)"/>
<output expression="&quot;A area do circulo e: &quot; &amp; ToFixed(area, 2) &amp; &quot; u.m2&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoArea = 4">
<then>
<output expression="&quot;Digite a diagonal maior do losango (em u.m): &quot;" newline="True"/>
<input variable="diagonalMaior"/>
<output expression="&quot;Digite a diagonal menor do losango (em u.m): &quot;" newline="True"/>
<input variable="diagonalMenor"/>
<assign variable="area" expression="(diagonalMaior * diagonalMenor) / 2"/>
<output expression="&quot;A area do losango e: &quot; &amp; ToFixed(area, 2) &amp; &quot; u.m2&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoArea = 5">
<then>
<output expression="&quot;Digite o comprimento do retangulo (u.m): &quot;" newline="True"/>
<input variable="compRet"/>
<output expression="&quot;Digite a largura do retangulo (u.m): &quot;" newline="True"/>
<input variable="largRet"/>
<assign variable="area" expression="compRet * largRet"/>
<output expression="&quot;A area do retangulo e: &quot; &amp; ToFixed(area, 2) &amp; &quot; u.m2&quot;" newline="True"/>
</then>
<else>
<output expression="&quot;Opcao invalida! Escolha uma figura entre 1 e 5.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 3">
<then>
<comment text="FUNCAO 3: Operacoes aritmeticas basicas (reune 5 sub-operacoes)"/>
<declare name="opcaoTabuada" type="Integer" array="False" size=""/>
<declare name="num1, num2, resultadoTabuada" type="Real" array="False" size=""/>
<declare name="expoente" type="Integer" array="False" size=""/>
<output expression="&quot;Escolha a operacao: [1] Soma | [2] Subtracao | [3] Multiplicacao | [4] Divisao | [5] Potencia | [0] para sair&quot;" newline="True"/>
<input variable="opcaoTabuada"/>
<while expression="opcaoTabuada &lt; 0 or opcaoTabuada &gt; 5">
<output expression="&quot;Erro! Essa opcao nao existe.&quot;" newline="True"/>
<output expression="&quot;Escolha a operacao: [1] Soma | [2] Subtracao | [3] Multiplicacao | [4] Divisao | [5] Potencia | [0] para sair&quot;" newline="True"/>
<input variable="opcaoTabuada"/>
</while>
<if expression="opcaoTabuada = 0">
<then>
<output expression="&quot;Fim do programa!&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoTabuada = 1">
<then>
<output expression="&quot;Digite o primeiro numero: &quot;" newline="True"/>
<input variable="num1"/>
<output expression="&quot;Digite o segundo numero: &quot;" newline="True"/>
<input variable="num2"/>
<assign variable="resultadoTabuada" expression="num1 + num2"/>
<output expression="&quot;A soma e: &quot; &amp; ToFixed(resultadoTabuada, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoTabuada = 2">
<then>
<output expression="&quot;Digite o primeiro numero: &quot;" newline="True"/>
<input variable="num1"/>
<output expression="&quot;Digite o segundo numero: &quot;" newline="True"/>
<input variable="num2"/>
<assign variable="resultadoTabuada" expression="num1 - num2"/>
<output expression="&quot;A subtracao e: &quot; &amp; ToFixed(resultadoTabuada, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoTabuada = 3">
<then>
<output expression="&quot;Digite o primeiro numero: &quot;" newline="True"/>
<input variable="num1"/>
<output expression="&quot;Digite o segundo numero: &quot;" newline="True"/>
<input variable="num2"/>
<assign variable="resultadoTabuada" expression="num1 * num2"/>
<output expression="&quot;A multiplicacao e: &quot; &amp; ToFixed(resultadoTabuada, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoTabuada = 4">
<then>
<output expression="&quot;Digite o numerador: &quot;" newline="True"/>
<input variable="num1"/>
<output expression="&quot;Digite o denominador: &quot;" newline="True"/>
<input variable="num2"/>
<comment text="Valida divisor para evitar divisao por zero"/>
<while expression="num2 = 0">
<output expression="&quot;Erro: divisao por zero nao e permitida.&quot;" newline="True"/>
<output expression="&quot;Digite o denominador: &quot;" newline="True"/>
<input variable="num2"/>
</while>
<assign variable="resultadoTabuada" expression="num1 / num2"/>
<output expression="&quot;A divisao e: &quot; &amp; ToFixed(resultadoTabuada, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoTabuada = 5">
<then>
<output expression="&quot;Digite a base: &quot;" newline="True"/>
<input variable="num1"/>
<output expression="&quot;Digite o expoente: &quot;" newline="True"/>
<input variable="expoente"/>
<assign variable="resultadoTabuada" expression="num1 ^ expoente"/>
<output expression="&quot;A potencia e: &quot; &amp; ToFixed(resultadoTabuada, 2)" newline="True"/>
</then>
<else>
<output expression="&quot;Opcao errada ou nao existe.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 4">
<then>
<comment text="FUNCAO 4: Identificacao de numero par ou impar"/>
<declare name="numero, resto" type="Integer" array="False" size=""/>
<output expression="&quot;Digite um numero inteiro: &quot;" newline="True"/>
<input variable="numero"/>
<assign variable="resto" expression="numero Mod 2"/>
<if expression="resto = 0">
<then>
<output expression="numero &amp; &quot; e PAR.&quot;" newline="True"/>
</then>
<else>
<output expression="numero &amp; &quot; e IMPAR.&quot;" newline="True"/>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 5">
<then>
<comment text="FUNCAO 5: Comparacao entre dois valores"/>
<declare name="valor1, valor2" type="Real" array="False" size=""/>
<output expression="&quot;Digite o primeiro valor: &quot;" newline="True"/>
<input variable="valor1"/>
<output expression="&quot;Digite o segundo valor: &quot;" newline="True"/>
<input variable="valor2"/>
<if expression="valor1 &gt; valor2">
<then>
<output expression="valor1 &amp; &quot; e maior que &quot; &amp; valor2" newline="True"/>
</then>
<else>
<if expression="valor1 &lt; valor2">
<then>
<output expression="valor2 &amp; &quot; e maior que &quot; &amp; valor1" newline="True"/>
</then>
<else>
<output expression="&quot;Os valores sao iguais.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 6">
<then>
<comment text="FUNCAO 6: Media aritmetica de tres notas"/>
<declare name="nota1, nota2, nota3, media" type="Real" array="False" size=""/>
<output expression="&quot;Digite a primeira nota: &quot;" newline="True"/>
<input variable="nota1"/>
<output expression="&quot;Digite a segunda nota: &quot;" newline="True"/>
<input variable="nota2"/>
<output expression="&quot;Digite a terceira nota: &quot;" newline="True"/>
<input variable="nota3"/>
<assign variable="media" expression="(nota1 + nota2 + nota3) / 3"/>
<output expression="&quot;A media e: &quot; &amp; ToFixed(media, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 7">
<then>
<comment text="FUNCAO 7: Calculo de porcentagem de um valor"/>
<declare name="valorPercentual, percentual, resultadoPorcentagem" type="Real" array="False" size=""/>
<output expression="&quot;Digite o valor: &quot;" newline="True"/>
<input variable="valorPercentual"/>
<output expression="&quot;Digite o percentual (%): &quot;" newline="True"/>
<input variable="percentual"/>
<assign variable="resultadoPorcentagem" expression="(valorPercentual * percentual) / 100"/>
<output expression="percentual &amp; &quot;% de &quot; &amp; valorPercentual &amp; &quot; e: &quot; &amp; ToFixed(resultadoPorcentagem, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 8">
<then>
<comment text="FUNCAO 8: Regra de tres simples direta (A esta para B, assim como C esta para X)"/>
<declare name="a, b, c, x" type="Real" array="False" size=""/>
<output expression="&quot;Digite o valor de A: &quot;" newline="True"/>
<input variable="a"/>
<comment text="Impede divisao por zero"/>
<while expression="a = 0">
<output expression="&quot;Erro: o valor de A nao pode ser zero.&quot;" newline="True"/>
<output expression="&quot;Digite o valor de A: &quot;" newline="True"/>
<input variable="a"/>
</while>
<output expression="&quot;Digite o valor de B: &quot;" newline="True"/>
<input variable="b"/>
<output expression="&quot;Digite o valor de C: &quot;" newline="True"/>
<input variable="c"/>
<assign variable="x" expression="(b * c) / a"/>
<output expression="&quot;Se &quot; &amp; a &amp; &quot; esta para &quot; &amp; b &amp; &quot;, entao &quot; &amp; c &amp; &quot; esta para X.&quot;" newline="True"/>
<output expression="&quot;O valor de X e: &quot; &amp; ToFixed(x, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 9">
<then>
<comment text="FUNCAO 9: Calculo de juros simples"/>
<declare name="capital, taxa, tempo, juros, montante" type="Real" array="False" size=""/>
<output expression="&quot;Digite o capital (R$): &quot;" newline="True"/>
<input variable="capital"/>
<output expression="&quot;Digite a taxa de juros (% ao mes): &quot;" newline="True"/>
<input variable="taxa"/>
<output expression="&quot;Digite o tempo (em meses): &quot;" newline="True"/>
<input variable="tempo"/>
<assign variable="juros" expression="(capital * taxa * tempo) / 100"/>
<assign variable="montante" expression="capital + juros"/>
<output expression="&quot;Juros: R$ &quot; &amp; ToFixed(juros, 2)" newline="True"/>
<output expression="&quot;Montante final: R$ &quot; &amp; ToFixed(montante, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 10">
<then>
<comment text="FUNCAO 10: Calculo de desconto sobre um preco"/>
<declare name="precoOriginal, percentualDesconto, valorDesconto, precoFinal" type="Real" array="False" size=""/>
<output expression="&quot;Digite o preco original (R$): &quot;" newline="True"/>
<input variable="precoOriginal"/>
<output expression="&quot;Digite o percentual de desconto (%): &quot;" newline="True"/>
<input variable="percentualDesconto"/>
<assign variable="valorDesconto" expression="(precoOriginal * percentualDesconto) / 100"/>
<assign variable="precoFinal" expression="precoOriginal - valorDesconto"/>
<output expression="&quot;Desconto: R$ &quot; &amp; ToFixed(valorDesconto, 2)" newline="True"/>
<output expression="&quot;Preco final: R$ &quot; &amp; ToFixed(precoFinal, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 11">
<then>
<comment text="FUNCAO 11: Conversao de temperatura entre escalas"/>
<declare name="opcaoTemp" type="Integer" array="False" size=""/>
<declare name="temperatura, resultadoTemp" type="Real" array="False" size=""/>
<output expression="&quot;Escolha: [1] Celsius -&gt; Fahrenheit | [2] Fahrenheit -&gt; Celsius | [3] Celsius -&gt; Kelvin | [0] para sair&quot;" newline="True"/>
<input variable="opcaoTemp"/>
<while expression="opcaoTemp &lt; 0 or opcaoTemp &gt; 3">
<output expression="&quot;Opcao errada ou inexistente! Tente novamente&quot;" newline="True"/>
<output expression="&quot;Escolha: [1] Celsius -&gt; Fahrenheit | [2] Fahrenheit -&gt; Celsius | [3] Celsius -&gt; Kelvin | [0] para sair&quot;" newline="True"/>
<input variable="opcaoTemp"/>
</while>
<if expression="opcaoTemp = 0">
<then>
<output expression="&quot;Fim do programa!&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoTemp = 1">
<then>
<output expression="&quot;Digite a temperatura em Celsius: &quot;" newline="True"/>
<input variable="temperatura"/>
<assign variable="resultadoTemp" expression="(temperatura * 9 / 5) + 32"/>
<output expression="&quot;Temperatura em Fahrenheit: &quot; &amp; ToFixed(resultadoTemp, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoTemp = 2">
<then>
<output expression="&quot;Digite a temperatura em Fahrenheit: &quot;" newline="True"/>
<input variable="temperatura"/>
<assign variable="resultadoTemp" expression="(temperatura - 32) * 5 / 9"/>
<output expression="&quot;Temperatura em Celsius: &quot; &amp; ToFixed(resultadoTemp, 2)" newline="True"/>
</then>
<else>
<if expression="opcaoTemp = 3">
<then>
<output expression="&quot;Digite a temperatura em Celsius: &quot;" newline="True"/>
<input variable="temperatura"/>
<assign variable="resultadoTemp" expression="temperatura + 273.15"/>
<output expression="&quot;Temperatura em Kelvin: &quot; &amp; ToFixed(resultadoTemp, 2)" newline="True"/>
</then>
<else>
<output expression="&quot;Opcao errada ou nao existe.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 12">
<then>
<comment text="FUNCAO 12: Conversor de unidades de medida (5 categorias)"/>
<declare name="tipoMedida, unidadeOrigem, unidadeDestino" type="Integer" array="False" size=""/>
<declare name="valor, fatorOrigem, fatorDestino, valorBase, resultadoConv" type="Real" array="False" size=""/>
<output expression="&quot;Escolha o tipo de medida: [1] Comprimento | [2] Area | [3] Volume | [4] Massa | [5] Capacidade | [0] para sair&quot;" newline="True"/>
<input variable="tipoMedida"/>
<while expression="tipoMedida &lt; 0 or tipoMedida &gt; 5">
<output expression="&quot;Tipo de medida invalido.&quot;" newline="True"/>
<output expression="&quot;Escolha o tipo de medida: [1] Comprimento | [2] Area | [3] Volume | [4] Massa | [5] Capacidade | [0] para sair&quot;" newline="True"/>
<input variable="tipoMedida"/>
</while>
<if expression="tipoMedida = 0">
<then>
<output expression="&quot;Fim do Programa!&quot;" newline="True"/>
</then>
<else>
<if expression="tipoMedida = 1">
<then>
<output expression="&quot;Unidade de origem: [1] mm | [2] cm | [3] dm | [4] m | [5] dam | [6] hm | [7] km&quot;" newline="True"/>
<input variable="unidadeOrigem"/>
<if expression="unidadeOrigem = 1">
<then>
<assign variable="fatorOrigem" expression="0.001"/>
</then>
<else>
<if expression="unidadeOrigem = 2">
<then>
<assign variable="fatorOrigem" expression="0.01"/>
</then>
<else>
<if expression="unidadeOrigem = 3">
<then>
<assign variable="fatorOrigem" expression="0.1"/>
</then>
<else>
<if expression="unidadeOrigem = 4">
<then>
<assign variable="fatorOrigem" expression="1"/>
</then>
<else>
<if expression="unidadeOrigem = 5">
<then>
<assign variable="fatorOrigem" expression="10"/>
</then>
<else>
<if expression="unidadeOrigem = 6">
<then>
<assign variable="fatorOrigem" expression="100"/>
</then>
<else>
<if expression="unidadeOrigem = 7">
<then>
<assign variable="fatorOrigem" expression="1000"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Unidade de destino: [1] mm | [2] cm | [3] dm | [4] m | [5] dam | [6] hm | [7] km&quot;" newline="True"/>
<input variable="unidadeDestino"/>
<if expression="unidadeDestino = 1">
<then>
<assign variable="fatorDestino" expression="0.001"/>
</then>
<else>
<if expression="unidadeDestino = 2">
<then>
<assign variable="fatorDestino" expression="0.01"/>
</then>
<else>
<if expression="unidadeDestino = 3">
<then>
<assign variable="fatorDestino" expression="0.1"/>
</then>
<else>
<if expression="unidadeDestino = 4">
<then>
<assign variable="fatorDestino" expression="1"/>
</then>
<else>
<if expression="unidadeDestino = 5">
<then>
<assign variable="fatorDestino" expression="10"/>
</then>
<else>
<if expression="unidadeDestino = 6">
<then>
<assign variable="fatorDestino" expression="100"/>
</then>
<else>
<if expression="unidadeDestino = 7">
<then>
<assign variable="fatorDestino" expression="1000"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Digite o valor a converter: &quot;" newline="True"/>
<input variable="valor"/>
<assign variable="valorBase" expression="valor * fatorOrigem"/>
<assign variable="resultadoConv" expression="valorBase / fatorDestino"/>
<output expression="&quot;Resultado: &quot; &amp; ToFixed(resultadoConv, 4)" newline="True"/>
</then>
<else>
<if expression="tipoMedida = 2">
<then>
<output expression="&quot;Unidade de origem: [1] cm2 | [2] dm2 | [3] m2&quot;" newline="True"/>
<input variable="unidadeOrigem"/>
<if expression="unidadeOrigem = 1">
<then>
<assign variable="fatorOrigem" expression="0.0001"/>
</then>
<else>
<if expression="unidadeOrigem = 2">
<then>
<assign variable="fatorOrigem" expression="0.01"/>
</then>
<else>
<if expression="unidadeOrigem = 3">
<then>
<assign variable="fatorOrigem" expression="1"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Unidade de destino: [1] cm2 | [2] dm2 | [3] m2&quot;" newline="True"/>
<input variable="unidadeDestino"/>
<if expression="unidadeDestino = 1">
<then>
<assign variable="fatorDestino" expression="0.0001"/>
</then>
<else>
<if expression="unidadeDestino = 2">
<then>
<assign variable="fatorDestino" expression="0.01"/>
</then>
<else>
<if expression="unidadeDestino = 3">
<then>
<assign variable="fatorDestino" expression="1"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Digite o valor a converter: &quot;" newline="True"/>
<input variable="valor"/>
<assign variable="valorBase" expression="valor * fatorOrigem"/>
<assign variable="resultadoConv" expression="valorBase / fatorDestino"/>
<output expression="&quot;Resultado: &quot; &amp; ToFixed(resultadoConv, 4)" newline="True"/>
</then>
<else>
<if expression="tipoMedida = 3">
<then>
<output expression="&quot;Unidade de origem: [1] cm3 | [2] dm3 | [3] m3&quot;" newline="True"/>
<input variable="unidadeOrigem"/>
<if expression="unidadeOrigem = 1">
<then>
<assign variable="fatorOrigem" expression="0.000001"/>
</then>
<else>
<if expression="unidadeOrigem = 2">
<then>
<assign variable="fatorOrigem" expression="0.001"/>
</then>
<else>
<if expression="unidadeOrigem = 3">
<then>
<assign variable="fatorOrigem" expression="1"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Unidade de destino: [1] cm3 | [2] dm3 | [3] m3&quot;" newline="True"/>
<input variable="unidadeDestino"/>
<if expression="unidadeDestino = 1">
<then>
<assign variable="fatorDestino" expression="0.000001"/>
</then>
<else>
<if expression="unidadeDestino = 2">
<then>
<assign variable="fatorDestino" expression="0.001"/>
</then>
<else>
<if expression="unidadeDestino = 3">
<then>
<assign variable="fatorDestino" expression="1"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Digite o valor a converter: &quot;" newline="True"/>
<input variable="valor"/>
<assign variable="valorBase" expression="valor * fatorOrigem"/>
<assign variable="resultadoConv" expression="valorBase / fatorDestino"/>
<output expression="&quot;Resultado: &quot; &amp; ToFixed(resultadoConv, 4)" newline="True"/>
</then>
<else>
<if expression="tipoMedida = 4">
<then>
<output expression="&quot;Unidade de origem: [1] mg | [2] g | [3] kg | [4] ton&quot;" newline="True"/>
<input variable="unidadeOrigem"/>
<if expression="unidadeOrigem = 1">
<then>
<assign variable="fatorOrigem" expression="0.000001"/>
</then>
<else>
<if expression="unidadeOrigem = 2">
<then>
<assign variable="fatorOrigem" expression="0.001"/>
</then>
<else>
<if expression="unidadeOrigem = 3">
<then>
<assign variable="fatorOrigem" expression="1"/>
</then>
<else>
<if expression="unidadeOrigem = 4">
<then>
<assign variable="fatorOrigem" expression="1000"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Unidade de destino: [1] mg | [2] g | [3] kg | [4] ton&quot;" newline="True"/>
<input variable="unidadeDestino"/>
<if expression="unidadeDestino = 1">
<then>
<assign variable="fatorDestino" expression="0.000001"/>
</then>
<else>
<if expression="unidadeDestino = 2">
<then>
<assign variable="fatorDestino" expression="0.001"/>
</then>
<else>
<if expression="unidadeDestino = 3">
<then>
<assign variable="fatorDestino" expression="1"/>
</then>
<else>
<if expression="unidadeDestino = 4">
<then>
<assign variable="fatorDestino" expression="1000"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Digite o valor a converter: &quot;" newline="True"/>
<input variable="valor"/>
<assign variable="valorBase" expression="valor * fatorOrigem"/>
<assign variable="resultadoConv" expression="valorBase / fatorDestino"/>
<output expression="&quot;Resultado: &quot; &amp; ToFixed(resultadoConv, 4)" newline="True"/>
</then>
<else>
<if expression="tipoMedida = 5">
<then>
<output expression="&quot;Unidade de origem: [1] ml | [2] l | [3] hl&quot;" newline="True"/>
<input variable="unidadeOrigem"/>
<if expression="unidadeOrigem = 1">
<then>
<assign variable="fatorOrigem" expression="0.001"/>
</then>
<else>
<if expression="unidadeOrigem = 2">
<then>
<assign variable="fatorOrigem" expression="1"/>
</then>
<else>
<if expression="unidadeOrigem = 3">
<then>
<assign variable="fatorOrigem" expression="100"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Unidade de destino: [1] ml | [2] l | [3] hl&quot;" newline="True"/>
<input variable="unidadeDestino"/>
<if expression="unidadeDestino = 1">
<then>
<assign variable="fatorDestino" expression="0.001"/>
</then>
<else>
<if expression="unidadeDestino = 2">
<then>
<assign variable="fatorDestino" expression="1"/>
</then>
<else>
<if expression="unidadeDestino = 3">
<then>
<assign variable="fatorDestino" expression="100"/>
</then>
<else>
<output expression="&quot;Unidade invalida.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
<output expression="&quot;Digite o valor a converter: &quot;" newline="True"/>
<input variable="valor"/>
<assign variable="valorBase" expression="valor * fatorOrigem"/>
<assign variable="resultadoConv" expression="valorBase / fatorDestino"/>
<output expression="&quot;Resultado: &quot; &amp; ToFixed(resultadoConv, 4)" newline="True"/>
</then>
<else>
<output expression="&quot;Opcao errada ou nao existe.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 13">
<then>
<comment text="FUNCAO 13: Trigonometria basica (seno, cosseno, tangente)"/>
<declare name="opcao" type="Integer" array="False" size=""/>
<declare name="angulo, anguloRad, resultadoTrig" type="Real" array="False" size=""/>
<output expression="&quot;Escolha: [1] Seno | [2] Cosseno | [3] Tangente | [0] para sair&quot;" newline="True"/>
<input variable="opcao"/>
<while expression="opcao &lt; 0 or opcao &gt; 3">
<output expression="&quot;Opcao errada ou nao existe.&quot;" newline="True"/>
<output expression="&quot;Escolha: [1] Seno | [2] Cosseno | [3] Tangente | [0] para sair&quot;" newline="True"/>
<input variable="opcao"/>
</while>
<output expression="&quot;Digite o angulo (em graus): &quot;" newline="True"/>
<input variable="angulo"/>
<comment text="Converte graus para radianos, pois as funcoes trig. usam radianos"/>
<assign variable="anguloRad" expression="angulo * 3.14159 / 180"/>
<if expression="opcao = 0">
<then>
<output expression="&quot;Programa encerrado!&quot;" newline="True"/>
</then>
<else>
<if expression="opcao = 1">
<then>
<assign variable="resultadoTrig" expression="SIN(anguloRad)"/>
<output expression="&quot;Seno de &quot; &amp; angulo &amp; &quot; graus: &quot; &amp; ToFixed(resultadoTrig, 4)" newline="True"/>
</then>
<else>
<if expression="opcao = 2">
<then>
<assign variable="resultadoTrig" expression="COS(anguloRad)"/>
<output expression="&quot;Cosseno de &quot; &amp; angulo &amp; &quot; graus: &quot; &amp; ToFixed(resultadoTrig, 4)" newline="True"/>
</then>
<else>
<if expression="opcao = 3">
<then>
<assign variable="resultadoTrig" expression="TAN(anguloRad)"/>
<output expression="&quot;Tangente de &quot; &amp; angulo &amp; &quot; graus: &quot; &amp; ToFixed(resultadoTrig, 4)" newline="True"/>
</then>
<else>
<output expression="&quot;Opcao errada ou nao existe.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 14">
<then>
<comment text="FUNCAO 14: Calculo de perimetro de figuras geometricas"/>
<declare name="opcaoPerimetro" type="Integer" array="False" size=""/>
<declare name="ladoPer, compPer, largPer, raioPer, perimetro" type="Real" array="False" size=""/>
<output expression="&quot;Escolha a figura: [1] Quadrado | [2] Retangulo | [3] Circulo | [4] Triangulo Equilatero&quot;" newline="True"/>
<input variable="opcaoPerimetro"/>
<if expression="opcaoPerimetro = 1">
<then>
<output expression="&quot;Digite o lado do quadrado (u.m): &quot;" newline="True"/>
<input variable="ladoPer"/>
<assign variable="perimetro" expression="4 * ladoPer"/>
<output expression="&quot;O perimetro do quadrado e: &quot; &amp; ToFixed(perimetro, 2) &amp; &quot; u.m&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoPerimetro = 2">
<then>
<output expression="&quot;Digite o comprimento do retangulo (u.m): &quot;" newline="True"/>
<input variable="compPer"/>
<output expression="&quot;Digite a largura do retangulo (u.m): &quot;" newline="True"/>
<input variable="largPer"/>
<assign variable="perimetro" expression="2 * (compPer + largPer)"/>
<output expression="&quot;O perimetro do retangulo e: &quot; &amp; ToFixed(perimetro, 2) &amp; &quot; u.m&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoPerimetro = 3">
<then>
<output expression="&quot;Digite o raio do circulo (u.m): &quot;" newline="True"/>
<input variable="raioPer"/>
<assign variable="perimetro" expression="2 * 3.14 * raioPer"/>
<output expression="&quot;O perimetro (circunferencia) e: &quot; &amp; ToFixed(perimetro, 2) &amp; &quot; u.m&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoPerimetro = 4">
<then>
<output expression="&quot;Digite o lado do triangulo equilatero (u.m): &quot;" newline="True"/>
<input variable="ladoPer"/>
<assign variable="perimetro" expression="3 * ladoPer"/>
<output expression="&quot;O perimetro do triangulo e: &quot; &amp; ToFixed(perimetro, 2) &amp; &quot; u.m&quot;" newline="True"/>
</then>
<else>
<output expression="&quot;Opcao invalida! Escolha uma figura entre 1 e 4.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 15">
<then>
<comment text="FUNCAO 15: Calculo de volume de solidos geometricos"/>
<declare name="opcaoVolume" type="Integer" array="False" size=""/>
<declare name="ladoVol, raioVol, alturaVol, compVol, largVol, volume" type="Real" array="False" size=""/>
<output expression="&quot;Escolha o solido: [1] Cubo | [2] Esfera | [3] Cilindro | [4] Paralelepipedo&quot;" newline="True"/>
<input variable="opcaoVolume"/>
<if expression="opcaoVolume = 1">
<then>
<output expression="&quot;Digite o lado do cubo (u.m): &quot;" newline="True"/>
<input variable="ladoVol"/>
<assign variable="volume" expression="ladoVol ^ 3"/>
<output expression="&quot;O volume do cubo e: &quot; &amp; ToFixed(volume, 2) &amp; &quot; u.m3&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoVolume = 2">
<then>
<output expression="&quot;Digite o raio da esfera (u.m): &quot;" newline="True"/>
<input variable="raioVol"/>
<assign variable="volume" expression="(4 / 3) * 3.14 * (raioVol ^ 3)"/>
<output expression="&quot;O volume da esfera e: &quot; &amp; ToFixed(volume, 2) &amp; &quot; u.m3&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoVolume = 3">
<then>
<output expression="&quot;Digite o raio da base do cilindro (u.m): &quot;" newline="True"/>
<input variable="raioVol"/>
<output expression="&quot;Digite a altura do cilindro (u.m): &quot;" newline="True"/>
<input variable="alturaVol"/>
<assign variable="volume" expression="3.14 * (raioVol ^ 2) * alturaVol"/>
<output expression="&quot;O volume do cilindro e: &quot; &amp; ToFixed(volume, 2) &amp; &quot; u.m3&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoVolume = 4">
<then>
<output expression="&quot;Digite o comprimento (u.m): &quot;" newline="True"/>
<input variable="compVol"/>
<output expression="&quot;Digite a largura (u.m): &quot;" newline="True"/>
<input variable="largVol"/>
<output expression="&quot;Digite a altura (u.m): &quot;" newline="True"/>
<input variable="alturaVol"/>
<assign variable="volume" expression="compVol * largVol * alturaVol"/>
<output expression="&quot;O volume do paralelepipedo e: &quot; &amp; ToFixed(volume, 2) &amp; &quot; u.m3&quot;" newline="True"/>
</then>
<else>
<output expression="&quot;Opcao invalida! Escolha um solido entre 1 e 4.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</then>
<else>
<if expression="opcaoCalculadora = 16">
<then>
<comment text="FUNCAO 16: Calculo de velocidade media (distancia / tempo)"/>
<declare name="distanciaVel, tempoVel, velocidadeMedia" type="Real" array="False" size=""/>
<output expression="&quot;Digite a distancia percorrida (km): &quot;" newline="True"/>
<input variable="distanciaVel"/>
<output expression="&quot;Digite o tempo gasto (horas): &quot;" newline="True"/>
<input variable="tempoVel"/>
<comment text="Evita divisao por zero"/>
<while expression="tempoVel &lt;= 0">
<output expression="&quot;Erro: o tempo deve ser maior que zero.&quot;" newline="True"/>
<output expression="&quot;Digite o tempo gasto (horas): &quot;" newline="True"/>
<input variable="tempoVel"/>
</while>
<assign variable="velocidadeMedia" expression="distanciaVel / tempoVel"/>
<output expression="&quot;A velocidade media e: &quot; &amp; ToFixed(velocidadeMedia, 2) &amp; &quot; km/h&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 17">
<then>
<comment text="FUNCAO 17: Calculo do consumo (autonomia) de combustivel"/>
<declare name="distanciaCons, combustivelCons, consumoMedio" type="Real" array="False" size=""/>
<output expression="&quot;Digite a distancia percorrida (km): &quot;" newline="True"/>
<input variable="distanciaCons"/>
<output expression="&quot;Digite a quantidade de combustivel gasta (litros): &quot;" newline="True"/>
<input variable="combustivelCons"/>
<comment text="Evita divisao por zero"/>
<while expression="combustivelCons &lt;= 0">
<output expression="&quot;Erro: a quantidade de combustivel deve ser maior que zero.&quot;" newline="True"/>
<output expression="&quot;Digite a quantidade de combustivel gasta (litros): &quot;" newline="True"/>
<input variable="combustivelCons"/>
</while>
<assign variable="consumoMedio" expression="distanciaCons / combustivelCons"/>
<output expression="&quot;O consumo medio e: &quot; &amp; ToFixed(consumoMedio, 2) &amp; &quot; km/l&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 18">
<then>
<comment text="FUNCAO 18: Calculo de idade a partir do ano de nascimento"/>
<declare name="anoNascimento, anoAtual, idadeCalculada" type="Integer" array="False" size=""/>
<output expression="&quot;Digite o ano de nascimento: &quot;" newline="True"/>
<input variable="anoNascimento"/>
<output expression="&quot;Digite o ano atual: &quot;" newline="True"/>
<input variable="anoAtual"/>
<comment text="Valida se o ano de nascimento nao e posterior ao ano atual"/>
<while expression="anoNascimento &gt; anoAtual">
<output expression="&quot;Erro: o ano de nascimento nao pode ser maior que o ano atual.&quot;" newline="True"/>
<output expression="&quot;Digite o ano de nascimento: &quot;" newline="True"/>
<input variable="anoNascimento"/>
</while>
<assign variable="idadeCalculada" expression="anoAtual - anoNascimento"/>
<output expression="&quot;A idade e: &quot; &amp; idadeCalculada &amp; &quot; anos&quot;" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 19">
<then>
<comment text="FUNCAO 19: Calculo do fatorial de um numero (uso de laco de repeticao)"/>
<declare name="numFatorial, contadorFat" type="Integer" array="False" size=""/>
<declare name="fatorial" type="Real" array="False" size=""/>
<output expression="&quot;Digite um numero inteiro nao negativo: &quot;" newline="True"/>
<input variable="numFatorial"/>
<comment text="Valida entrada: fatorial so existe para numeros &gt;= 0"/>
<while expression="numFatorial &lt; 0">
<output expression="&quot;Erro: digite um numero maior ou igual a zero.&quot;" newline="True"/>
<input variable="numFatorial"/>
</while>
<assign variable="fatorial" expression="1"/>
<assign variable="contadorFat" expression="1"/>
<comment text="Multiplica de 1 ate o numero informado"/>
<while expression="contadorFat &lt;= numFatorial">
<assign variable="fatorial" expression="fatorial * contadorFat"/>
<assign variable="contadorFat" expression="contadorFat + 1"/>
</while>
<output expression="numFatorial &amp; &quot;! = &quot; &amp; ToFixed(fatorial, 0)" newline="True"/>
</then>
<else>
<if expression="opcaoCalculadora = 20">
<then>
<comment text="FUNCAO 20: Verificacao se um numero e primo (uso de laco e decisao)"/>
<declare name="numPrimo, divisor, ehPrimo" type="Integer" array="False" size=""/>
<output expression="&quot;Digite um numero inteiro maior que 1: &quot;" newline="True"/>
<input variable="numPrimo"/>
<comment text="Assume que o numero e primo ate encontrar um divisor"/>
<assign variable="ehPrimo" expression="1"/>
<if expression="numPrimo &lt;= 1">
<then>
<assign variable="ehPrimo" expression="0"/>
</then>
<else>
<assign variable="divisor" expression="2"/>
<while expression="divisor &lt; numPrimo">
<if expression="numPrimo Mod divisor = 0">
<then>
<assign variable="ehPrimo" expression="0"/>
</then>
<else>
<comment text="nao faz nada, apenas avanca o laco"/>
</else>
</if>
<assign variable="divisor" expression="divisor + 1"/>
</while>
</else>
</if>
<if expression="ehPrimo = 1">
<then>
<output expression="numPrimo &amp; &quot; e um numero PRIMO.&quot;" newline="True"/>
</then>
<else>
<output expression="numPrimo &amp; &quot; NAO e um numero primo.&quot;" newline="True"/>
</else>
</if>
</then>
<else>
<output expression="&quot;Opcao errada ou nao existe.&quot;" newline="True"/>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
</else>
</if>
        </body>
    </function>
</flowgorithm>
